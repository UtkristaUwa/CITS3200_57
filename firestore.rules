rules_version = '2';

// TenderAI Firestore rules.
//
// Authentication is a gate, not a permission system: every signed-in user is
// entitled to see the same tenders. Per-user favourites and the last tender
// visit timestamp live on the user's own users/{uid} document.
//
// That document also carries `isAdmin`, and the browser has to be able to write
// to it for favourites to work — so these rules exist to say which fields a
// client may touch. Without them, any user could grant themselves admin, which
// unlocks the user-management page and the inviteUser function (that function
// authorises by reading this same field), and from there the sign-in gate can be
// opened from the inside.
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin access is derived from the caller's server-managed profile. The
    // client update allowlist below never permits isAdmin to be changed.
    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.get('isAdmin', false) == true;
    }

    // Which fields this write is trying to change.
    function touched() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // AuthContext flips status pending -> active on first successful login, to
    // prove an invited user set their password. That is the only status change a
    // client may make, and only in that direction.
    function statusChangeIsFirstLogin() {
      return !touched().hasAny(['status'])
             || (resource.data.get('status', '') == 'pending'
                 && request.resource.data.status == 'active');
    }

    function lastTenderVisitChangeIsValid() {
      return !touched().hasAny(['lastTenderVisitAt'])
             || (request.resource.data.lastTenderVisitAt is timestamp
                 && request.resource.data.lastTenderVisitAt == request.time);
    }

    // Keep these values in sync with frontend/src/lib/tenderPreferences.ts.
    function compactFieldsAreValid(compactFields) {
      return compactFields is list
             && compactFields.size() <= 9
             && compactFields.toSet().size() == compactFields.size()
             && compactFields.toSet().hasOnly([
               'atAGlance',
               'atmId',
               'closingDate',
               'agency',
               'source',
               'monetaryValue',
               'openingDate',
               'location',
               'status'
             ]);
    }

    function cardViewIsValid(cardView) {
      return cardView is map
             && cardView.keys().hasAll(['compactFields'])
             && cardView.keys().hasOnly(['compactFields'])
             && compactFieldsAreValid(cardView.compactFields);
    }

    function yearIsValid(year) {
      return year is string
             && (year == '' || year.matches('^[0-9]{4}$'));
    }

    function dateIsValid(date) {
      return date is string
             && (date == ''
                 || date.matches(
                   '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'
                 ));
    }

    function legacyDefaultFiltersShapeIsValid(defaultFilters) {
      return defaultFilters.keys().hasAll([
               'jurisdiction', 'status', 'year', 'minDate', 'maxDate'
             ])
             && defaultFilters.keys().hasOnly([
               'jurisdiction', 'status', 'year', 'minDate', 'maxDate'
             ]);
    }

    function extendedDefaultFiltersShapeIsValid(defaultFilters) {
      return defaultFilters.keys().hasAll([
               'jurisdiction',
               'states',
               'sourceId',
               'focusAreas',
               'status',
               'year',
               'minDate',
               'maxDate',
               'publishedAfter',
               'publishedBefore'
             ])
             && defaultFilters.keys().hasOnly([
               'jurisdiction',
               'states',
               'sourceId',
               'focusAreas',
               'status',
               'year',
               'minDate',
               'maxDate',
               'publishedAfter',
               'publishedBefore'
             ]);
    }

    function statesAreValid(states) {
      return states is list
             && states.size() <= 8
             && states.toSet().size() == states.size()
             && states.toSet().hasOnly([
               'ACT', 'NSW', 'NT', 'QLD', 'SA', 'TAS', 'VIC', 'WA'
             ]);
    }

    function dynamicIdIsValid(value) {
      return value is string
             && value.size() <= 100
             && value.matches('^[a-z][a-z0-9_]*$');
    }

    // Firestore Rules has no list-wide predicate. Keep this explicit validation
    // in sync with MAX_FOCUS_AREAS in tenderPreferences.ts.
    function focusAreasAreValid(focusAreas) {
      return focusAreas is list
             && focusAreas.size() <= 12
             && focusAreas.toSet().size() == focusAreas.size()
             && (focusAreas.size() < 1 || dynamicIdIsValid(focusAreas[0]))
             && (focusAreas.size() < 2 || dynamicIdIsValid(focusAreas[1]))
             && (focusAreas.size() < 3 || dynamicIdIsValid(focusAreas[2]))
             && (focusAreas.size() < 4 || dynamicIdIsValid(focusAreas[3]))
             && (focusAreas.size() < 5 || dynamicIdIsValid(focusAreas[4]))
             && (focusAreas.size() < 6 || dynamicIdIsValid(focusAreas[5]))
             && (focusAreas.size() < 7 || dynamicIdIsValid(focusAreas[6]))
             && (focusAreas.size() < 8 || dynamicIdIsValid(focusAreas[7]))
             && (focusAreas.size() < 9 || dynamicIdIsValid(focusAreas[8]))
             && (focusAreas.size() < 10 || dynamicIdIsValid(focusAreas[9]))
             && (focusAreas.size() < 11 || dynamicIdIsValid(focusAreas[10]))
             && (focusAreas.size() < 12 || dynamicIdIsValid(focusAreas[11]));
    }

    function sourceIdIsValid(sourceId) {
      return sourceId is string
             && sourceId.size() <= 100
             && (sourceId == ''
                 || sourceId.matches('^[A-Za-z0-9][A-Za-z0-9_-]*$'));
    }

    function extendedDefaultFilterValuesAreValid(defaultFilters) {
      return statesAreValid(defaultFilters.states)
             && sourceIdIsValid(defaultFilters.sourceId)
             && focusAreasAreValid(defaultFilters.focusAreas)
             && dateIsValid(defaultFilters.publishedAfter)
             && dateIsValid(defaultFilters.publishedBefore);
    }

    function defaultFiltersAreValid(defaultFilters) {
      return defaultFilters is map
             && (legacyDefaultFiltersShapeIsValid(defaultFilters)
                 || (extendedDefaultFiltersShapeIsValid(defaultFilters)
                     && extendedDefaultFilterValuesAreValid(defaultFilters)))
             && defaultFilters.jurisdiction is string
             && defaultFilters.jurisdiction.size() <= 200
             && defaultFilters.status is string
             && defaultFilters.status in ['', 'open', 'closed', 'awarded', 'unknown']
             && yearIsValid(defaultFilters.year)
             && dateIsValid(defaultFilters.minDate)
             && dateIsValid(defaultFilters.maxDate);
    }

    function tenderPreferencesAreValid(preferences) {
      return preferences is map
             && preferences.keys().hasAll([
               'schemaVersion', 'cardView', 'defaultFilters'
             ])
             && preferences.keys().hasOnly([
               'schemaVersion', 'cardView', 'defaultFilters'
             ])
             && preferences.schemaVersion is int
             && preferences.schemaVersion == 1
             && cardViewIsValid(preferences.cardView)
             && defaultFiltersAreValid(preferences.defaultFilters);
    }

    // Legacy profiles may not have preferences. Unrelated permitted updates
    // remain valid, but adding, replacing, or removing preferences must leave
    // a complete valid preference map.
    function tenderPreferencesChangeIsValid() {
      return !touched().hasAny(['tenderPreferences'])
             || (request.resource.data.keys().hasAll(['tenderPreferences'])
                 && tenderPreferencesAreValid(
                   request.resource.data.tenderPreferences
                 ));
    }

    match /users/{uid} {
      // Users need their own profile for auth and favourites. Only an admin may
      // read another profile or list the collection for User Management.
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      // Own document only, and only the fields the UI legitimately writes.
      // Note what this excludes: isAdmin, email, active, createdAt, invitedBy.
      allow update: if isSelf(uid)
                    && touched().hasOnly([
                      'favoriteTenderIds',
                      'status',
                      'lastTenderVisitAt',
                      'tenderPreferences'
                    ])
                    && statusChangeIsFirstLogin()
                    && lastTenderVisitChangeIsValid()
                    && tenderPreferencesChangeIsValid();

      // Profile documents are created and removed server side only — by
      // api/app/auth.py on first Entra sign-in, or by the inviteUser function.
      // Both use the Admin SDK, which bypasses these rules entirely.
      //
      // This is deliberately strict: a client that could create its own profile
      // could recreate one for a revoked account, and a document carrying
      // neither `active` nor `status` reads as active to the API.
      allow create, delete: if false;
    }

    // Email-keyed invites, read and deleted by the API's Admin SDK. No client
    // has any business here.
    match /pending_users/{email} {
      allow read, write: if false;
    }

    // Anything not named above is closed. New collections must opt in here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
