GOOGLE_CLOUD_PROJECT=tenderai-dev
BIGQUERY_DATASET=TenderAI

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Set true to serve fixture data instead of querying BigQuery
# (useful for frontend dev with no GCP credentials).
USE_MOCK_DATA=false

# Entra ID SSO — a first-time sign-in from the client's tenant is turned into
# an active, non-admin users/{uid} doc. Set false to require a pre-created
# profile for every user, SSO included.
AUTO_PROVISION_SSO=true

# Optional extra guard on top of the Entra tenant boundary. Empty = accept any
# address the tenant issues. Comma-separated, no '@'.
ALLOWED_EMAIL_DOMAINS=
