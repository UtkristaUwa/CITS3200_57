# Copy to .env.local for local development (not committed).

# Where the FastAPI backend is running.
VITE_API_BASE_URL=http://localhost:8000

# Directory (tenant) ID of the client's Entra tenant, from the app
# registration overview blade — see docs/SSO_SETUP.md. Without it, the
# Microsoft button falls back to the shared /common endpoint and personal
# Microsoft accounts can reach the consent screen.
VITE_ENTRA_TENANT_ID=
